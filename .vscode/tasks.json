{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-local-server",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "> node serve\\.js",
          "endsPattern": "Server running at http://(127\\.0\\.0\\.1|::1):8080"
        }
      }
    }
  ]
}
